{
  "name": "galago",
  "license": "0BSD",
  "slug": "galago",
  "version": "1.0.0",
  "owner": "techwizardgalago",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest --config jest.contract.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && expo export -p web --clear",
    "serve:web": "expo serve"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "expo": "~53.0.9",
    "expo-auth-session": "~6.2.1",
    "expo-constants": "~17.1.6",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.7",
    "expo-secure-store": "~14.2.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-svg-uri": "^2.0.0",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "lodash": "^4.17.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.15.1",
    "react-native-web": "^0.20.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "eas-cli": "^16.23.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~9.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "react-native-svg-transformer": "^1.5.2",
    "react-test-renderer": "^19.0.0"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "logic",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/__tests__/logic/**/*.test.js"
        ]
      },
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/__tests__/app/**/*.test.js",
          "<rootDir>/__tests__/store/**/*.test.js",
          "<rootDir>/__tests__/hooks/**/*.test.js"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|native-base|react-native-svg|immer|react-redux))"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "testMatch": [
          "<rootDir>/__tests__/app/**/*.test.js",
          "<rootDir>/__tests__/store/**/*.test.js",
          "<rootDir>/__tests__/hooks/**/*.test.js"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|native-base|react-native-svg|immer|react-redux))"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "testMatch": [
          "<rootDir>/__tests__/app/**/*.test.js",
          "<rootDir>/__tests__/store/**/*.test.js"
        ]
      }
    ]
  }
}
